<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsPublishable>false</IsPublishable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Bogus" Version="35.6.5" />
        <PackageReference Include="coverlet.collector" Version="6.0.4">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
        <PackageReference Include="Moq" Version="4.20.72" />
        <PackageReference Include="RichardSzalay.MockHttp" Version="7.0.0" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3" Version="3.2.2" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\FplClient\FplClient.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="..\FplClientTests\TestData\fixtures.json" />
        <EmbeddedResource Include="..\FplClientTests\TestData\bootstrap-static.json" />
        <EmbeddedResource Include="..\FplClientTests\TestData\element-summary.json" />
        <EmbeddedResource Include="..\FplClientTests\TestData\event-live.json" />
        <EmbeddedResource Include="..\FplClientTests\TestData\manager.json" />
        <EmbeddedResource Include="..\FplClientTests\TestData\manager-history.json" />
        <EmbeddedResource Include="..\FplClientTests\TestData\transfers.json" />
    </ItemGroup>

</Project>
